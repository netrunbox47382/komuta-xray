pid /tmp/km-nginx.pid;
error_log stderr warn;
worker_processes 1;
events { worker_connections 256; }
http {
  access_log off;
  default_type application/octet-stream;
  types { text/html html htm; }
  client_body_temp_path /tmp/km-client;
  proxy_temp_path /tmp/km-proxy;
  fastcgi_temp_path /tmp/km-fastcgi;
  uwsgi_temp_path /tmp/km-uwsgi;
  scgi_temp_path /tmp/km-scgi;
  server {
    listen __PORT__;
    server_name _;
    root /var/www/html;
    location / {
      try_files $uri $uri/ =404;
    }
    location __WS_PATH__ {
      proxy_pass http://127.0.0.1:10002;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
  }
}
